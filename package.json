{
  "name": "deskweek-float",
  "productName": "DeskWeek",
  "version": "2.1.0",
  "description": "A small desktop floating weekly calendar and deadline-sorted todo list.",
  "main": "src/main/index.cjs",
  "private": true,
  "license": "MIT",
  "author": "小虾",
  "scripts": {
    "start": "node scripts/run.cjs",
    "package": "node scripts/package.cjs",
    "package:installer": "node scripts/build-installer.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test test/*.test.cjs",
    "test:host": "node scripts/run.cjs --host-test",
    "test:qr": "node scripts/run.cjs --qr-test",
    "test:packaged": "node scripts/run.cjs --host-test --packaged-code",
    "test:visibility": "node scripts/run.cjs --visibility-test",
    "test:resume": "node scripts/run.cjs --resume-test",
    "test:appearance": "node scripts/run.cjs --appearance-test",
    "test:concurrency": "node scripts/run.cjs --concurrency-test"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "koffi": "3.3.3",
    "mammoth": "1.13.0",
    "pdf-parse": "1.1.1",
    "qrcode": "1.5.4",
    "word-extractor": "1.0.4",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "innosetup": "^6.4.1"
  }
}
